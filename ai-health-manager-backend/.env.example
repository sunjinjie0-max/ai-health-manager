DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
EXERCISE_LLM_REFINE_ENABLED=false
ENVIRONMENT_LLM_ADVICE_ENABLED=false

DASHSCOPE_API_KEY=your_dashscope_api_key_here
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
DASHSCOPE_EMBEDDING_DIMENSION=1024
RAG_EMBEDDING_MODEL=dashscope-text-embedding-v4
RAG_EMBEDDING_BATCH_SIZE=10

JWT_SECRET_KEY=change-this-to-a-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# Long-term local development stack (Docker Compose)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/ai_health
ELASTICSEARCH_URL=http://127.0.0.1:9200
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Optional Elasticsearch auth settings
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_API_KEY=

# Hybrid memory/profile extraction
MEMORY_WRITE_ENABLED=true
MEMORY_USE_LLM_SUPPLEMENT=true
PROFILE_USE_LLM_SUPPLEMENT=true
PROFILE_LLM_MIN_CONFIDENCE=0.75
PROFILE_HIGH_RISK_CONFIRMATION=true

# Optional local fallback if you temporarily do not use PostgreSQL
# DATABASE_URL=sqlite+aiosqlite:///./data/health.db

RATE_LIMIT_GENERAL=100
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_LLM=20
RATE_LIMIT_LLM_WINDOW_MINUTES=60
